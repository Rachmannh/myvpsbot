# Konfigurasi Bot Telegram
TELEGRAM_BOT_TOKEN="8867780037:AAH1OZTeBb0i5nE-x3E7peUDsG8NR2pBFfI"
TELEGRAM_CHAT_ID="7689116453"

# Path File Log Web Server (Pilih salah satu sesuai web server Anda)
# Nginx: /var/log/nginx/access.log
# Apache: /var/log/apache2/access.log
LOG_FILE_PATH="/var/log/nginx/access.log"

# Path GeoIP Database lokal (MaxMind GeoLite2-City atau GeoLite2-Country)
# Jika dikosongkan atau file tidak ditemukan, bot otomatis fallback ke API ip-api.com
GEOIP_DB_PATH="/usr/share/GeoIP/GeoLite2-City.mmdb"

# Ambang Batas Deteksi Serangan (Security Alert)
# Trigger jika IP melakukan > RATE_LIMIT_THRESHOLD hits dalam RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_THRESHOLD=20
RATE_LIMIT_WINDOW_SECONDS=60

# Interval Laporan Berkala (dalam detik, misal 3600 = 1 jam, 86400 = 24 jam)
REPORT_INTERVAL_SECONDS=3600

# Endpoint Sensitif (pisahkan dengan koma)
# Hit ke endpoint ini akan dipantau ekstra ketat untuk alert instan
SENSITIVE_PATHS="/wp-login.php,/xmlrpc.php,/admin,/login,/api/v1/auth,/.env,/config,/phpmyadmin"
